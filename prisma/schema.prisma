// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   // passenger, admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passenger Passenger?
  userTickets Ticket[]

  @@map("users")
}

model Passenger {
  id        Int      @id @default(autoincrement())
  name      String
  passport  String   @unique
  email     String   @unique
  phone     String
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  @@map("passengers")
}

model Flight {
  id        Int      @id @default(autoincrement())
  from      String
  to        String
  date      String
  time      String
  status    String   @default("В ожидании") // В ожидании, В пути, Задержан, Завершён
  plane     String
  price     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crew    CrewMember[]
  tickets Ticket[]

  @@map("flights")
}

model Staff {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   // Пилот, Стюардесса, Инженер
  email     String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crew CrewMember[]

  @@map("staff")
}

model CrewMember {
  id       Int
  flightId Int
  staffId  Int

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([id, flightId, staffId])
  @@map("crew_members")
}

model Ticket {
  id          Int      @id @default(autoincrement())
  flightId    Int
  passengerId Int
  userId      Int
  seat        String
  price       Int
  status      String   @default("Забронирован") // Забронирован, Оплачен, Отменён, Использован
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flight    Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tickets")
}